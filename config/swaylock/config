# swaylock config

daemonize
show-failed-attempts
ignore-empty-password

# Colors — Chrome Gray (bg #2b2b2b, accent blue #8ab4f8)
color=2b2b2b
inside-color=2b2b2b
ring-color=8ab4f8
key-hl-color=aac8ff
bs-hl-color=e08a84
line-color=00000000
separator-color=00000000

inside-ver-color=3c3c3c
ring-ver-color=c9b88f
inside-wrong-color=3c3c3c
ring-wrong-color=e08a84

text-color=e0e0e0
text-ver-color=c9b88f
text-wrong-color=e08a84
text-clear-color=aac8ff

# Font
font=JetBrainsMono Nerd Font
font-size=16

# Image (optional — uncomment and set path)
# image=~/.config/sway/wallpaper

indicator-radius=80
indicator-thickness=6
